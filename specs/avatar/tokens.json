{
  "$schema": "../../_templates/component/tokens.schema.json",
  "component": "avatar",
  "source": "https://github.com/tishsingh399/clementine-ds",
  "version": "clementine-ds@0.1.0",
  "verified": "2026-06-10",
  "fork_model": "3-tier cascade: component → semantic → primitive. Components never reference primitives directly.",
  "notes": [
    "All entries are tier=component, defined in packages/tokens/src/components/avatar.json.",
    "`references` is the semantic token bound; `primitive` is the resolved primitive after the second hop.",
    "Light-mode values shown; dark resolves through the same semantic names in semantic-dark.json."
  ],
  "tokens": [
    { "name": "avatar.bg", "tier": "component", "role": "placeholder-fill", "path": "avatar.bg", "references": "{surface.subtle}", "primitive": "{palette.neutral.2}", "light": "#f6f6f4", "status": "existing" },
    { "name": "avatar.fg", "tier": "component", "role": "initials-color", "path": "avatar.fg", "references": "{text.secondary}", "primitive": "{palette.neutral.11}", "light": "#65635e", "status": "existing" },
    { "name": "avatar.border", "tier": "component", "role": "group-ring", "path": "avatar.border", "references": "{border.default}", "primitive": "{palette.neutral.6}", "light": "#d5d3d0", "status": "existing" },
    { "name": "avatar.ring", "tier": "component", "role": "focus-ring", "path": "avatar.ring", "references": "{focus.ring}", "primitive": "{palette.clementine.10}", "light": "#e86800", "status": "existing" },
    { "name": "avatar.radius", "tier": "component", "role": "corner-radius", "path": "avatar.radius", "references": "{radius.xl}", "primitive": "99px", "light": "99px", "status": "existing" }
  ]
}
